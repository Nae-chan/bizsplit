# Copy to .env.local for local development. Never commit real values.
# Production (ADR-0008) is Neon's direct host, not the -pooler one, with full TLS verification:
# postgresql://USER:PASSWORD@ep-XXXX.us-east-1.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL=postgres://user:password@localhost:5432/bizsplit

# Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000

# Email (optional in dev; console fallback logs the links)
RESEND_API_KEY=
EMAIL_FROM="BizSplit <noreply@bizsplit.app>"

# Secrets encryption (Shopify tokens at rest)
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
